{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "michels-travel-simple",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-10",
  "workers_dev": true,
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "vars": { "MODE": "test", "MARKUP_RATE": "0.085", "TURNSTILE_SITE_KEY": "1x00000000000000000000AA", "CONTACT_EMAIL": "michelstravel@gmail.com" },
  "d1_databases": [{ "binding": "DB", "database_name": "michels-travel-simple", "database_id": "CONFIGURE_D1_ID", "migrations_dir": "migrations" }],
  "env": {
    "production": {
      "name": "michels-travel-simple",
      "vars": { "MODE": "live", "MARKUP_RATE": "0.085", "TURNSTILE_SITE_KEY": "CONFIGURE_REAL_SITE_KEY", "CONTACT_EMAIL": "michelstravel@gmail.com" },
      "d1_databases": [{ "binding": "DB", "database_name": "michels-travel-simple", "database_id": "CONFIGURE_D1_ID", "migrations_dir": "migrations" }]
    }
  }
}
